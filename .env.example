# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# --- MongoDB Atlas ---
# Atlas dashboard -> Connect -> Drivers -> copy the connection string,
# then swap in your database user's password and a database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/podcast_studio?retryWrites=true&w=majority

# --- Single-user auth ---
APP_USER_EMAIL=you@example.com
# Generate with: npm run hash-password
APP_USER_PASSWORD_HASH=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Secret encryption ---
# AES-256-GCM key for encrypting TTS provider API keys at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# --- Backblaze B2 (S3-compatible API) ---
# B2 dashboard -> Application Keys (create one scoped to your bucket) and
# Buckets -> your bucket -> "Endpoint" for B2_ENDPOINT.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=podcast-studio-audio
B2_KEY_ID=
B2_APPLICATION_KEY=
# Optional but recommended: your Cloudflare CDN / custom domain in front
# of the bucket. If unset, falls back to B2's own public URL directly.
B2_PUBLIC_BASE_URL=https://audio.example.com

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
