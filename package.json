{
  "name": "podcast-studio-backend",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js + TypeScript API for Podcast Studio: MongoDB Atlas for data, Backblaze B2 for audio storage, ElevenLabs + Cartesia for TTS.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "hash-password": "tsx scripts/hashPassword.ts",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.679.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.3",
    "music-metadata": "^7.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/bcryptjs": "^2.4.6",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
